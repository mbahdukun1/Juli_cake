# Salin jadi `.env.local` (tidak ikut ter-commit), lalu isi.
# Nilai ada di Supabase → Project Settings → API.
# Di Vercel, isi variabel yang sama di Project Settings → Environment Variables.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon" / "publishable" key — memang aman ditaruh di website; yang menjaga
# data adalah aturan RLS di supabase/schema.sql. JANGAN pakai service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Email akun admin yang dibuat di Authentication → Users.
# Kalau diisi, halaman login /dashboard cukup minta password.
EXPO_PUBLIC_ADMIN_EMAIL=
